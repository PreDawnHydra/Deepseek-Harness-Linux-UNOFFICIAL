diff --git a/apps/desktop/tests/welcome-skip.spec.ts b/apps/desktop/tests/welcome-skip.spec.ts
new file mode 100644
index 00000000..f9bf20f5
--- /dev/null
+++ b/apps/desktop/tests/welcome-skip.spec.ts
@@ -0,0 +1,25 @@
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { setWelcomeSkipRemembered, welcomeSkipRemembered } from '../src/welcome-skip.ts'
+
+const roots: string[] = []
+afterEach(() => { for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true }) })
+
+describe('remembered welcome skip', () => {
+  it('is off until remembered, survives re-reads, and clears again', () => {
+    const root = mkdtempSync(join(tmpdir(), 'dsh-welcome-skip-'))
+    roots.push(root)
+    const marker = join(root, 'nested', 'welcome-skip-remembered')
+    expect(welcomeSkipRemembered(marker)).toBe(false)
+    setWelcomeSkipRemembered(marker, true)
+    expect(welcomeSkipRemembered(marker)).toBe(true)
+    setWelcomeSkipRemembered(marker, true)
+    expect(welcomeSkipRemembered(marker)).toBe(true)
+    setWelcomeSkipRemembered(marker, false)
+    expect(welcomeSkipRemembered(marker)).toBe(false)
+    setWelcomeSkipRemembered(marker, false)
+    expect(welcomeSkipRemembered(marker)).toBe(false)
+  })
+})
