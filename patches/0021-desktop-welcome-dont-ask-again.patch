diff --git a/apps/desktop/src/welcome-skip.ts b/apps/desktop/src/welcome-skip.ts
new file mode 100644
index 00000000..f8b4541e
--- /dev/null
+++ b/apps/desktop/src/welcome-skip.ts
@@ -0,0 +1,32 @@
+/** Linux port: remember "Don't ask again" on the welcome window across launches. */
+
+import { existsSync, mkdirSync, rmSync, writeFileSync } from 'node:fs'
+import { dirname } from 'node:path'
+
+/**
+ * Report whether the user asked to skip the welcome on every launch.
+ * @param markerPath - Marker file under the application's userData directory.
+ * @returns true while the marker exists.
+ */
+export function welcomeSkipRemembered(markerPath: string): boolean {
+  return existsSync(markerPath)
+}
+
+/**
+ * Record or clear the persistent skip. Failures are logged and never block entering the workspace:
+ * the worst outcome is upstream's behaviour, the welcome showing again next launch.
+ * @param markerPath - Marker file under the application's userData directory.
+ * @param remember - true writes the marker; false removes it.
+ */
+export function setWelcomeSkipRemembered(markerPath: string, remember: boolean): void {
+  try {
+    if (remember) {
+      mkdirSync(dirname(markerPath), { recursive: true })
+      writeFileSync(markerPath, '')
+    } else {
+      rmSync(markerPath, { force: true })
+    }
+  } catch (error) {
+    console.warn('desktop welcome: could not update the remembered skip', error)
+  }
+}
