+/**
+ * Resolve the update feed a Linux build embeds.
+ * The feed is a generic electron-updater directory holding `nightly-linux.yml` (x64) or
+ * `nightly-linux-arm64.yml` beside the artifacts, such as a GitHub `releases/latest/download` URL.
+ * @param {NodeJS.ProcessEnv} environment File-owned release settings.
+ * @returns {string | undefined} Feed URL without a trailing slash, or undefined when updates are off.
+ */
+export function resolveDesktopLinuxUpdateFeed(environment = process.env) {
+  const configured = environment[LINUX_UPDATE_URL_ENV]?.trim() ?? ''
+  if (configured === '') return undefined
+  let url
+  try { url = new URL(configured) }
+  catch { throw new Error(`desktop package: ${LINUX_UPDATE_URL_ENV} must be an absolute https URL`) }
+  // The updater replaces the installed application with whatever this feed names, so plain HTTP is refused.
+  if (url.protocol !== 'https:' || url.search !== '' || url.hash !== '') {
+    throw new Error(`desktop package: ${LINUX_UPDATE_URL_ENV} must be an absolute https URL without a query or fragment`)
+  }
+  return configured.replace(/\/+$/u, '')
+}
